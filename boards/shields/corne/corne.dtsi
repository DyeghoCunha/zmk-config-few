#include <dt-bindings/zmk/matrix_transform.h>

#include <layouts/foostan/corne/5column.dtsi>




&foostan_corne_5col_layout {
    transform = <&five_column_transform>;
};

&{/chosen} {
    /* Display padrão do teclado */
    zephyr,display = &oled;

    /* Driver de varredura da matriz */
    zmk,kscan = &kscan0;

    /* AJUSTE 1/2: usar 5 colunas por lado (10 no total) */
    zmk,physical-layout = &foostan_corne_5col_layout;
};

/* ----- Transforms ----- */
/* Mapeamento 6x2 (12 colunas totais) — mantido para referência/uso futuro */


/* AJUSTE 2/2: Transform de 5 colunas por lado (removendo a 1ª e a 12ª colunas) */
five_column_transform: keymap_transform_1 {
    compatible = "zmk,matrix-transform";
    columns = <10>;
    rows = <4>;
    // | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  |
    // | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  |
    // | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 |
    //               | SW19 | SW20 | SW21 |   | SW21 | SW20 | SW19 |
    map = <
     /* Use este transform quando quiser 5 colunas por lado (10 no total). 
 * Removemos as colunas centrais C5 (esq) e C6 (dir), preservando C0.
 */
five_column_transform: keymap_transform_1 {
    compatible = "zmk,matrix-transform";
    columns = <12>;
    rows = <4>;
    // Linha 0
    // | C0  C1  C2  C3  C4 |   | C7  C8  C9  C10 C11 |
    map = <
       RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)                         RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
       RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)                         RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
       RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)         RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                                 RC(2,12) RC(2,13) RC(2,14)         RC(2,15) RC(2,16) RC(2,17)
    >;
};

    >;
};

/* ----- KSCAN ----- */
kscan0: kscan {
    compatible = "zmk,kscan-gpio-matrix";
    wakeup-source;

    diode-direction = "col2row";

    /* As linhas permanecem iguais; as colunas “removidas” são descartadas pelo five_column_transform */
    row-gpios
        = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
        ;
};

/* ----- OLED no barramento I2C do Pro Micro ----- */
&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        /* Use a forma compatível que você já utiliza no restante do projeto.
           Se o driver exigir o sufixo -i2c, troque abaixo para "solomon,ssd1306fb-i2c". */
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
    };
};

